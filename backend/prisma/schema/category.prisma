model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  label     String    @unique
  products  Product[]
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  image     File?
  banners   Banner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
